{
  "name": "icbc-carbon-transition-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/python.cjs -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "dev:frontend": "npm run dev --workspace carbon-transition-frontend",
    "build": "npm run build --workspace carbon-transition-frontend",
    "test": "node scripts/python.cjs -m pytest -q",
    "test:graph": "node --test tests/test_network_view.mjs",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "latest"
  }
}
